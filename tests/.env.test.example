# Test-only environment for the local test infrastructure (docker-compose.test.yml, project orc-test).
# Copy to tests/.env.test only if you need to override a value. These are NOT production secrets:
# they only unlock the throwaway mssql-test (127.0.0.1:14331) and redis-test (127.0.0.1:16380) containers.
# tests/setup/test-env.ts refuses to run unless NODE_ENV=test, DB_NAME ends with _test and hosts are loopback.

NODE_ENV=test
LOG_LEVEL=silent
DB_HOST=127.0.0.1
DB_PORT=14331
DB_NAME=orchestrator_test
DB_USER=orc_migrator
DB_PASSWORD=OrcTest_Migrator_2026!
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true
MSSQL_SA_PASSWORD=OrcTestOnly_Sa_2026!
DB_MIGRATOR_PASSWORD=OrcTest_Migrator_2026!
DB_API_PASSWORD=OrcTest_Api_Login_2026!
DB_WORKER_PASSWORD=OrcTest_Worker_Login_2026!
DB_BACKUP_PASSWORD=OrcTest_Backup_Login_2026!
CLAUDE_DEFAULT_MODEL=sonnet
PASSWORD_SCRYPT_N=16384
REDIS_HOST=127.0.0.1
REDIS_PORT=16380
REDIS_PASSWORD=orc-test-only-redis-pw
