{
  "extends": "./tsconfig.base.json",
  "include": [
    "packages/*/src/**/*.ts",
    "apps/api/src/**/*.ts",
    "apps/worker/src/**/*.ts",
    "apps/egress-proxy/src/**/*.ts",
    "apps/runner/src/**/*.ts",
    "apps/api/tsup.config.ts",
    "apps/worker/tsup.config.ts",
    "apps/egress-proxy/tsup.config.ts",
    "apps/runner/tsup.config.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "apps/web",
    "**/node_modules",
    "**/dist",
    "**/coverage"
  ]
}
