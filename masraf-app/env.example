# Masraf mobil uygulamasının ayarları.
# Kullanım: bu dosyayı aynı klasörde ".env" adıyla kopyalayın (Windows: copy env.example .env)
# ve değerleri düzenleyin. Expo yalnızca EXPO_PUBLIC_ ile başlayan değişkenleri uygulamaya aktarır.
# Bu değerler uygulama paketine gömülür: buraya şifre veya token yazmayın.
# Değişiklikten sonra Metro'yu önbelleği temizleyerek yeniden başlatın: npx expo start -c

# Sunucunun adresi (zorunlu). Tanımlı değilse uygulama açılışta bir uyarı ekranı gösterir.
# - iPhone ya da Wi-Fi'deki telefon: sunucunun .env dosyasında AG_ERISIMI=yerel olmalı. Adres,
#   bilgisayarın Wi-Fi adresidir; sunucu açılışta "Yerel ağdan: http://..." satırında yazar.
#   Örnek: EXPO_PUBLIC_API_URL=http://192.168.1.20:4000  (telefonda 127.0.0.1 telefonun kendisidir)
# - Android emülatörü veya USB ile bağlı Android: önce "adb reverse tcp:4000 tcp:4000" çalıştırın.
# - iOS simülatörü: bilgisayarın 127.0.0.1 adresini doğrudan kullanır.
EXPO_PUBLIC_API_URL=http://127.0.0.1:4000

# Fatura okunurken durumun kaç milisaniyede bir sorulacağı (GET /api/invoices/toplu/:id).
# Varsayılan 2500. İzin verilen aralık 1000–30000.
EXPO_PUBLIC_OKUMA_SORGU_ARALIGI_MS=2500

# Okuma için en fazla ne kadar bekleneceği (milisaniye). Süre dolunca kullanıcı formu elle doldurabilir.
# Varsayılan 300000 (5 dakika). İzin verilen aralık 30000–1800000.
EXPO_PUBLIC_OKUMA_UST_SURE_MS=300000

# Bir API isteğinin zaman aşımı (milisaniye). Varsayılan 20000. İzin verilen aralık 3000–120000.
EXPO_PUBLIC_ISTEK_ZAMAN_ASIMI_MS=20000

# Fatura dosyası yükleme isteğinin zaman aşımı (milisaniye). Büyük PDF'ler için daha uzundur.
# Varsayılan 60000. İzin verilen aralık 10000–300000.
EXPO_PUBLIC_YUKLEME_ZAMAN_ASIMI_MS=60000
