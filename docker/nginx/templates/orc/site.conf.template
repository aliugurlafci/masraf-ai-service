# Site configuration, rendered at container start by the image's envsubst step into
# /tmp/orc/site.conf. Substituted variables (NGINX_ENVSUBST_FILTER): API_UPSTREAM, WEB_SERVER_NAME.

# Docker's embedded DNS: the api container is re-resolved after it is recreated.
resolver 127.0.0.11 ipv6=off valid=10s;
resolver_timeout 5s;

# Plain HTTP (container 8080, published as 8088) only redirects to HTTPS (ADR-0025).
server {
    listen 8080 default_server;
    server_name _;

    location / {
        return 301 https://$host:8443$request_uri;
    }
}

server {
    listen 8443 ssl default_server;
    http2 on;
    server_name ${WEB_SERVER_NAME};

    ssl_certificate /run/secrets/web_tls_cert;
    ssl_certificate_key /run/secrets/web_tls_key;

    # Mozilla "intermediate" profile: TLS 1.2/1.3, AEAD ECDHE suites, no session tickets.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ecdh_curve X25519:prime256v1:secp384r1;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:OrcTLS:10m;
    ssl_session_tickets off;

    root /usr/share/nginx/html;
    index index.html;

    set $api_upstream ${API_UPSTREAM};

    # Liveness of the web container itself (container healthcheck).
    location = /health/live {
        access_log off;
        include /etc/nginx/orc/security-headers.conf;
        add_header Cache-Control "no-store" always;
        default_type application/json;
        return 200 '{"status":"ok"}';
    }

    # Readiness = the API behind this proxy is ready (GET /api/v1/health/ready).
    location = /health/ready {
        access_log off;
        limit_except GET {
            deny all;
        }
        include /etc/nginx/orc/api-proxy.conf;
        proxy_pass $api_upstream/api/v1/health/ready;
    }

    # Same-origin API, including the SSE stream (unbuffered, long read timeout).
    location /api/ {
        include /etc/nginx/orc/api-proxy.conf;
        proxy_pass $api_upstream;
    }

    # Content-hashed build output: cache forever.
    location /assets/ {
        include /etc/nginx/orc/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # SPA routes fall back to index.html, which is always revalidated.
    location / {
        include /etc/nginx/orc/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }
}
