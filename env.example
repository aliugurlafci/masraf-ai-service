# Masraf servisi ayarları. Bu dosyayı ".env" adıyla kopyalayın ve değerleri doldurun:
#   copy env.example .env        (PowerShell / cmd)
# Sunucu (npm start) ve Docker (npm run db:up) aynı .env dosyasını okur.
# Özel karakter içeren değerleri tek tırnak içinde yazın: MSSQL_PASSWORD='Ab$12#cd'

# ── Sunucu ────────────────────────────────────────────────────────────────
# Dinlenen port.
PORT=4000
# Ağ erişimi. "kapali": sunucu yalnızca 127.0.0.1 adresinde dinler, yalnızca bu bilgisayar bağlanır.
# "yerel": aynı Wi-Fi/yerel ağdaki telefonlar da bağlanabilir (iPhone, Wi-Fi'deki Android). Yalnızca
# özel ağ adreslerinden (192.168.x.x, 10.x.x.x, 172.16–31.x.x) gelen isteklere yanıt verir. Bağlantı
# şifresiz HTTP'dir, aynı ağdaki biri oturumları ve faturaları görebilir: misafir ve halka açık
# Wi-Fi'de açmayın. Açılışta sunucu, mobil uygulamaya yazılacak adresi konsola yazar.
AG_ERISIMI=kapali
# Yerel ağ erişiminde, bilgisayarın IP adreslerine ek olarak kabul edilen adlar (virgülle, en çok 10).
# Örnek: masraf-pc.local. Bilgisayarın IP adresleri her zaman kabul edilir, buraya yazmanız gerekmez.
IZINLI_HOSTLAR=
# En büyük fatura dosyası (MB, 1–32).
MAX_FILE_MB=20

# ── Veritabanı (Docker'daki SQL Server) ───────────────────────────────────
# Docker imajı ve sürümü.
MSSQL_IMAGE=mcr.microsoft.com/mssql/server:2022-latest
# SQL Server sürümü: Developer, Express, Standard, Enterprise (lisansınıza göre).
MSSQL_PID=Developer
MSSQL_HOST=127.0.0.1
MSSQL_PORT=14333
# Sunucu açılışta bu veritabanını yoksa oluşturur ve tabloları kurar. Testler "<ad>_test_<n>" adlı
# ayrı veritabanları kullanır.
MSSQL_DATABASE=masraf
MSSQL_USER=sa
# Zorunlu. En az 8 karakter; büyük harf, küçük harf, rakam ve sembolden en az üçünü içermeli.
# Docker bu şifreyi yalnızca veritabanı ilk oluşturulurken kullanır. Sonradan değiştirmek için
# önce SQL Server'da sa şifresini değiştirin, sonra burayı güncelleyin.
MSSQL_PASSWORD=Test_Masraf_2026!
# Bağlantıyı TLS ile şifrele. Yerel Docker kendi imzaladığı sertifikayı kullandığı için güven ayarı açık.
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=true
# Bağlantı havuzundaki en fazla bağlantı (1–100).
MSSQL_POOL_MAX=10
# Açılışta veritabanının hazır olmasını en fazla kaç saniye bekleyeceği (0–600). Konteyner yeni
# başladıysa SQL Server'ın açılması 10–30 saniye sürer.
MSSQL_CONNECT_WAIT_SEC=60

# ── İlk yönetici ──────────────────────────────────────────────────────────
# Veritabanında hiç kullanıcı yoksa ilk açılışta bu yönetici oluşturulur ve onay akışının
# ilk onaycısı olur (0 – sınırsız). Kullanıcı varken bu değerler kullanılmaz.
ILK_YONETICI_EPOSTA=ugur.lafci@senpilic.com.tr
ILK_YONETICI_SIFRE=Aliugur1
ILK_YONETICI_AD=Sistem Yöneticisi

# ── Oturum ve güvenlik ────────────────────────────────────────────────────
# Oturum süresi (saat, 1–8760). Kullanıldıkça uzar.
OTURUM_SURESI_SAAT=168
# Arka arkaya bu kadar hatalı girişte e-posta geçici olarak kilitlenir (3–100).
GIRIS_DENEME_SINIRI=10
# Kilit süresi (dakika, 1–1440).
GIRIS_KILIT_DAKIKA=15
# En kısa şifre uzunluğu (8–128).
SIFRE_MIN_UZUNLUK=8

# ── Masraf ────────────────────────────────────────────────────────────────
# Onay aralıklarının ve raporların para birimi (ISO 4217). Başka para birimindeki
# masraflarda kur girilir.
PARA_BIRIMI=TRY

# ── Claude (fatura okuma) ─────────────────────────────────────────────────
# Claude Code CLI'nin yolu.
CLAUDE_BIN=claude
# Modeller, en ucuzdan başlayarak virgülle (en çok 4). Sonraki model yalnızca kontroller tutmazsa çalışır.
CLAUDE_MODEL=haiku,opus
# Düşünme düzeyi: low, medium, high, xhigh, max ya da default (CLI'nin kendi ayarı).
CLAUDE_EFFORT=low
# Bir fatura için en uzun bekleme (saniye, 10–900).
CLAUDE_TIMEOUT_SEC=180
# Aynı anda okunan fatura sayısı (1–4).
CLAUDE_MAX_CONCURRENT=4
# Abonelik token'ının dosyası ("claude setup-token" çıktısı). Varsayılan: secrets/claude_oauth_token.txt
# CLAUDE_OAUTH_TOKEN_FILE=secrets/claude_oauth_token.txt
# Ya da token'ın kendisi (dosya yerine). Paylaşmayın.
# CLAUDE_CODE_OAUTH_TOKEN=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
