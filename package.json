{
  "name": "claude-code-orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:api && npm run build:worker && npm run build:egress-proxy && npm run build:web",
    "build:api": "npm run build --workspace @orc/api",
    "build:worker": "npm run build --workspace @orc/worker",
    "build:egress-proxy": "npm run build --workspace @orc/egress-proxy",
    "build:web": "npm run build --workspace @orc/web",
    "dev:setup": "node scripts/dev-setup.mjs",
    "dev:create-admin": "node scripts/dev-run.mjs create-admin",
    "dev:api": "node scripts/dev-run.mjs api",
    "dev:worker": "node scripts/dev-run.mjs worker",
    "dev:web": "npm run dev --workspace @orc/web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "test": "vitest run --project unit --project integration --project api --project security --project e2e --project web",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:api": "vitest run --project api",
    "test:security": "node scripts/check-placeholders.mjs && node scripts/dependency-audit.mjs && vitest run --project security",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "test:e2e": "vitest run --project e2e",
    "test:web": "vitest run --project web",
    "test:report": "node tests/helpers/common/test-report.ts",
    "test:claude-live": "node scripts/run-claude-live.mjs",
    "test:linux": "node scripts/test-linux.mjs",
    "test:compose": "node scripts/compose-smoke.mjs",
    "infra:test:up": "docker compose -f docker-compose.test.yml -p orc-test up -d --wait",
    "infra:test:down": "docker compose -f docker-compose.test.yml -p orc-test down -v",
    "secrets:generate": "node scripts/generate-secrets.mjs",
    "certs:generate": "node scripts/generate-certs.mjs",
    "compose:config": "node scripts/compose-check.mjs && docker compose config --quiet",
    "compose:up": "node scripts/compose-check.mjs && docker compose up -d --build --wait",
    "compose:down": "docker compose down",
    "compose:backup": "node scripts/backup.mjs",
    "compose:restore": "node scripts/restore.mjs",
    "db:bootstrap": "tsx packages/database/src/cli/orc-db.ts bootstrap",
    "db:migrate": "tsx packages/database/src/cli/orc-db.ts migrate",
    "db:seed": "tsx packages/database/src/cli/orc-db.ts seed",
    "db:create-admin": "tsx packages/database/src/cli/orc-db.ts create-admin",
    "db:backup": "tsx packages/database/src/cli/orc-db.ts backup",
    "audit:deps": "node scripts/dependency-audit.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "msgpackr-extract@3.0.6": true,
    "@scarf/scarf": false
  }
}
