{
  "name": "masraf-ai-service",
  "version": "1.0.0",
  "private": true,
  "description": "Fatura dosyasını (PDF/resim) yerel Claude Code aboneliğiyle okuyup fatura ve kalemlerini JSON olarak döndüren yerel servis",
  "type": "module",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch src/server.ts",
    "karsilastir": "node src/compare-models.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "5.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
